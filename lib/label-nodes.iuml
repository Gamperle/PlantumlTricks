' Label-as-node helpers for readable labels under `skinparam linetype ortho`.
' Paste into your diagram (a PlantUML server cannot !include local files),
' or !include it when rendering with the plantuml jar.
'
'   $lbl(id, text)               declare a label node - call it INSIDE the package
'                                the link belongs to (or its target package)
'   $via(a, id, b, dir, arrow)   route a -> label -> b ; dir = down|up|left|right
'                                positions the label relative to a
'
' Example:
'   $lbl(l_charge, "charge(order)")
'   $via(order, l_charge, pay, "right")
'   note right of l_charge : retries: 3

skinparam rectangle<<lbl>> {
  BorderColor transparent
  BackgroundColor transparent
  FontSize 10
  FontColor #444444
  Shadow false
}
hide <<lbl>> stereotype

!procedure $lbl($id, $text)
  rectangle "$text" <<lbl>> as $id
!endprocedure

!procedure $via($a, $id, $b, $dir="down", $arr="-->")
  $a -$dir- $id
  $id $arr $b
!endprocedure
